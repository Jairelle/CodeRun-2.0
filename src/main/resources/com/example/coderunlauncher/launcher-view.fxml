<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="450.0" maxWidth="800.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coderunlauncher.LauncherController">
   <children>

      <!-- Background Image (shared by all views) -->
      <ImageView fx:id="bgImageView" fitHeight="450.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@images/bg.png" />
         </image>
      </ImageView>

      <!-- ==================== MAIN MENU PANE ==================== -->
      <VBox fx:id="mainMenuPane" alignment="CENTER_RIGHT" prefHeight="450.0" prefWidth="632.0" translateX="1.0" translateY="5.0" StackPane.alignment="CENTER">
         <children>
            <Button fx:id="loginButton" mnemonicParsing="false" onAction="#showLoginView" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
               <graphic>
                  <ImageView fitHeight="45.0" fitWidth="300.0" pickOnBounds="true">
                     <image><Image url="@images/4.png" /></image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="signUpButton" mnemonicParsing="false" onAction="#showSignUpView" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
               <graphic>
                  <ImageView fitHeight="45.0" fitWidth="300.0" pickOnBounds="true">
                     <image><Image url="@images/5.png" /></image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="settingsButton" mnemonicParsing="false" onAction="#showSettingsView" prefWidth="250.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
               <graphic>
                  <ImageView fitHeight="45.0" fitWidth="300.0" pickOnBounds="true">
                     <image><Image url="@images/6.png" /></image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="exitButton" mnemonicParsing="false" onAction="#handleExit" prefWidth="250.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
               <graphic>
                  <ImageView fitHeight="45.0" fitWidth="300.0" pickOnBounds="true">
                     <image><Image url="@images/7.png" /></image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
         <padding>
            <Insets right="80.0" top="50.0" />
         </padding>
      </VBox>

      <!-- ==================== LOGIN PANE ==================== -->
      <VBox fx:id="loginPane" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="250.0" prefWidth="422.0" spacing="6.0" translateX="-20.0" translateY="60.0" visible="false" StackPane.alignment="CENTER_RIGHT">
         <children>

            <!-- Username Field -->
            <StackPane maxWidth="320.0" minWidth="320.0" prefWidth="320.0">
               <children>
                  <ImageView fitHeight="40.0" fitWidth="320.0" pickOnBounds="true">
                     <image><Image url="@images/input_box.png" /></image>
                  </ImageView>
                  <TextField fx:id="usernameField" alignment="CENTER" maxWidth="260.0" prefHeight="40.0" prefWidth="260.0" promptText="Username" style="-fx-background-color: transparent; -fx-text-fill: #3b2314; -fx-prompt-text-fill: #7a5c43; -fx-alignment: center; -fx-font-weight: bold;">
                     <font><Font name="JetBrainsMono NF Light Italic" size="15.0" /></font>
                  </TextField>
               </children>
            </StackPane>

            <!-- Password Field -->
            <StackPane maxWidth="320.0" minWidth="320.0" prefWidth="320.0">
               <children>
                  <ImageView fitHeight="40.0" fitWidth="320.0" pickOnBounds="true">
                     <image><Image url="@images/input_box.png" /></image>
                  </ImageView>
                  <PasswordField fx:id="passwordField" alignment="CENTER" maxWidth="260.0" prefWidth="260.0" promptText="Password" style="-fx-background-color: transparent; -fx-text-fill: #3b2314; -fx-prompt-text-fill: #7a5c43; -fx-alignment: center; -fx-font-weight: bold;">
                     <font><Font name="JetBrainsMono NF Light Italic" size="15.0" /></font>
                  </PasswordField>
               </children>
            </StackPane>

            <!-- Remember username -->
            <HBox alignment="CENTER_LEFT" maxWidth="320.0">
               <VBox.margin><Insets bottom="2.0" top="2.0" /></VBox.margin>
               <children>
                  <CheckBox fx:id="rememberCheck" mnemonicParsing="false" styleClass="remember-check" text="Remember my username">
                     <font>
                        <Font name="JetBrainsMono NF Light Italic" size="13.0" />
                     </font></CheckBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="forgotButton" mnemonicParsing="false" onAction="#showForgotView" styleClass="link-button" text="Forgot password?">
                     <font>
                        <Font name="JetBrainsMono NF Light Italic" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>

            <!-- Action Button (Login) -->
            <StackPane prefWidth="200.0">
               <children>
                  <ImageView fitHeight="31.0" fitWidth="198.0" pickOnBounds="true">
                     <image><Image url="@images/play_now.png" /></image>
                  </ImageView>
                  <Button fx:id="actionButton" mnemonicParsing="false" onAction="#handleAction" prefHeight="31.0" prefWidth="198.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
               </children>
            </StackPane>

            <!-- Toggle Button -->
            <Button fx:id="toggleButton" mnemonicParsing="false" onAction="#toggleMode" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-cursor: hand; -fx-font-size: 11px;" text="Don't have an account? Create one">
               <VBox.margin><Insets top="2.0" /></VBox.margin>
            </Button>

            <HBox alignment="CENTER" maxWidth="340.0" prefHeight="26.0" spacing="6.0">
               <children>
                  <ProgressIndicator fx:id="loginSpinner" maxHeight="20.0" maxWidth="20.0" prefHeight="20.0" prefWidth="20.0" visible="false" />
                  <Label fx:id="statusLabel" maxWidth="300.0" styleClass="status-label" textAlignment="CENTER" wrapText="true" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- ==================== SIGN-UP PANE ====================
           Flat layout, no translateX/translateY offsets. Everything is positioned by
           the VBox padding + spacing, so it lines up with the bg_signup.png artwork.
           Form column is 290px wide, starting 130px from the left edge.
           NOTE: the controller's eye-icon toggle expects
                 StackPane > HBox > signUpPasswordField, so keep that nesting. -->
      <VBox fx:id="signUpPane" alignment="TOP_LEFT" maxHeight="450.0" maxWidth="800.0" pickOnBounds="false" prefHeight="450.0" prefWidth="800.0" spacing="6.0" visible="false" StackPane.alignment="CENTER">
         <padding>
            <Insets left="130.0" top="160.0" />
         </padding>
         <children>

            <!-- Username -->
            <StackPane alignment="CENTER_LEFT" maxHeight="34.0" maxWidth="290.0" minHeight="34.0" minWidth="290.0" prefHeight="34.0" prefWidth="290.0">
               <children>
                  <ImageView fitHeight="34.0" fitWidth="290.0" pickOnBounds="true" preserveRatio="false">
                     <image><Image url="@images/forSignUp/input_plank.png" /></image>
                  </ImageView>
                  <HBox alignment="CENTER_LEFT" maxHeight="34.0" maxWidth="290.0" spacing="8.0">
                     <padding><Insets left="14.0" right="12.0" /></padding>
                     <children>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image><Image url="@images/forSignUp/icon_user.png" /></image>
                        </ImageView>
                        <TextField fx:id="signUpUsernameField" prefHeight="28.0" promptText="Enter your username" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0 0 0 2; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-prompt-text-fill: #c9a96e; -fx-font-size: 12px;" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </StackPane>

            <!-- Email -->
            <StackPane alignment="CENTER_LEFT" maxHeight="34.0" maxWidth="290.0" minHeight="34.0" minWidth="290.0" prefHeight="34.0" prefWidth="290.0">
               <children>
                  <ImageView fitHeight="34.0" fitWidth="290.0" pickOnBounds="true" preserveRatio="false">
                     <image><Image url="@images/forSignUp/input_plank.png" /></image>
                  </ImageView>
                  <HBox alignment="CENTER_LEFT" maxHeight="34.0" maxWidth="290.0" spacing="8.0">
                     <padding><Insets left="14.0" right="12.0" /></padding>
                     <children>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image><Image url="@images/forSignUp/icon_email.png" /></image>
                        </ImageView>
                        <TextField fx:id="emailField" prefHeight="28.0" promptText="Enter your email address" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0 0 0 2; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-prompt-text-fill: #c9a96e; -fx-font-size: 12px;" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </StackPane>

            <!-- Password (with eye toggle) -->
            <StackPane alignment="CENTER_LEFT" maxHeight="34.0" maxWidth="290.0" minHeight="34.0" minWidth="290.0" prefHeight="34.0" prefWidth="290.0">
               <children>
                  <ImageView fitHeight="34.0" fitWidth="290.0" pickOnBounds="true" preserveRatio="false">
                     <image><Image url="@images/forSignUp/input_plank.png" /></image>
                  </ImageView>
                  <HBox alignment="CENTER_LEFT" maxHeight="34.0" maxWidth="290.0" spacing="8.0">
                     <padding><Insets left="14.0" right="12.0" /></padding>
                     <children>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image><Image url="@images/forSignUp/icon_lock.png" /></image>
                        </ImageView>
                        <PasswordField fx:id="signUpPasswordField" prefHeight="28.0" promptText="Enter your password" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0 0 0 2; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-prompt-text-fill: #c9a96e; -fx-font-size: 12px;" HBox.hgrow="ALWAYS" />
                        <ImageView fx:id="eyeIcon" fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                           <image><Image url="@images/forSignUp/icon_eye.png" /></image>
                        </ImageView>
                     </children>
                  </HBox>
               </children>
            </StackPane>

            <!-- OTP squares + Send Code -->
            <HBox fx:id="otpBox" alignment="CENTER_LEFT" maxWidth="290.0" spacing="4.0">
               <children>
                  <StackPane maxHeight="30.0" maxWidth="30.0" minHeight="30.0" minWidth="30.0" prefHeight="30.0" prefWidth="30.0">
                     <children>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="otp1" alignment="CENTER" maxWidth="26.0" prefHeight="26.0" prefWidth="26.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="30.0" maxWidth="30.0" minHeight="30.0" minWidth="30.0" prefHeight="30.0" prefWidth="30.0">
                     <children>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="otp2" alignment="CENTER" maxWidth="26.0" prefHeight="26.0" prefWidth="26.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="30.0" maxWidth="30.0" minHeight="30.0" minWidth="30.0" prefHeight="30.0" prefWidth="30.0">
                     <children>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="otp3" alignment="CENTER" maxWidth="26.0" prefHeight="26.0" prefWidth="26.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="30.0" maxWidth="30.0" minHeight="30.0" minWidth="30.0" prefHeight="30.0" prefWidth="30.0">
                     <children>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="otp4" alignment="CENTER" maxWidth="26.0" prefHeight="26.0" prefWidth="26.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="30.0" maxWidth="30.0" minHeight="30.0" minWidth="30.0" prefHeight="30.0" prefWidth="30.0">
                     <children>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="otp5" alignment="CENTER" maxWidth="26.0" prefHeight="26.0" prefWidth="26.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="30.0" maxWidth="30.0" minHeight="30.0" minWidth="30.0" prefHeight="30.0" prefWidth="30.0">
                     <children>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="otp6" alignment="CENTER" maxWidth="26.0" prefHeight="26.0" prefWidth="26.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>

                  <!-- Send Code -->
                  <StackPane maxHeight="26.0" maxWidth="64.0" minHeight="26.0" minWidth="64.0" prefHeight="26.0" prefWidth="64.0">
                     <HBox.margin><Insets left="6.0" /></HBox.margin>
                     <children>
                        <ImageView fitHeight="26.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/btn_send_code.png" /></image>
                        </ImageView>
                        <Button fx:id="sendCodeButton" mnemonicParsing="false" onAction="#handleSendCode" prefHeight="26.0" prefWidth="64.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 10px; -fx-cursor: hand;" />
                     </children>
                  </StackPane>
               </children>
            </HBox>

            <!-- Complete Registration -->
            <StackPane maxHeight="34.0" maxWidth="266.0" minHeight="34.0" minWidth="266.0" prefHeight="34.0" prefWidth="266.0">
               <VBox.margin><Insets left="12.0" top="3.0" /></VBox.margin>
               <children>
                  <ImageView fitHeight="34.0" fitWidth="266.0" pickOnBounds="true" preserveRatio="false">
                     <image><Image url="@images/forSignUp/btn_register.png" /></image>
                  </ImageView>
                  <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleSignUpAction" prefHeight="34.0" prefWidth="266.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" />
               </children>
            </StackPane>

            <!-- "Already have an account? Log in" pill -->
            <StackPane alignment="CENTER" maxHeight="20.0" maxWidth="240.0" minHeight="20.0" minWidth="240.0" prefHeight="20.0" prefWidth="240.0">
               <VBox.margin><Insets left="28.0" top="3.0" /></VBox.margin>
               <children>
                  <ImageView fitHeight="20.0" fitWidth="240.0" pickOnBounds="true" preserveRatio="false">
                     <image><Image url="@images/forSignUp/bg_pill.png" /></image>
                  </ImageView>
                  <HBox alignment="CENTER" maxWidth="240.0" spacing="4.0">
                     <children>
                        <Label style="-fx-text-fill: #3b2314; -fx-font-size: 10px; -fx-font-weight: bold;" />
                        <Button fx:id="signUpToggleButton" mnemonicParsing="false" onAction="#handleBackToLogin" style="-fx-background-color: transparent; -fx-text-fill: #1f5fbf; -fx-font-weight: bold; -fx-font-size: 10px; -fx-cursor: hand; -fx-underline: true; -fx-padding: 0;" text="Log in" translateX="80.0" />
                     </children>
                  </HBox>
               </children>
            </StackPane>

            <!-- Status Label for sign-up feedback -->
            <Label fx:id="signUpStatusLabel" alignment="CENTER" maxWidth="290.0" prefWidth="290.0" style="-fx-text-fill: red; -fx-font-size: 12px; -fx-font-weight: bold;" textAlignment="CENTER" wrapText="true">
               <VBox.margin><Insets top="2.0" /></VBox.margin>
            </Label>

         </children>
      </VBox>

      <!-- ==================== FORGOT PASSWORD PANE ====================
           Same look as the login pane: planks and painted buttons straight on the artwork. -->
      <VBox fx:id="forgotPane" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="250.0" prefWidth="422.0" spacing="6.0" translateX="-20.0" translateY="60.0" visible="false" StackPane.alignment="CENTER_RIGHT">
         <children>
            <Label styleClass="pane-title" text="Reset your password"><font><Font name="JetBrainsMono NF Light Italic" size="15.0" /></font></Label>
            <StackPane maxWidth="320.0" minWidth="320.0" prefWidth="320.0">
               <children>
                  <ImageView fitHeight="40.0" fitWidth="320.0" pickOnBounds="true">
                     <image><Image url="@images/input_box.png" /></image>
                  </ImageView>
                  <TextField fx:id="resetEmailField" alignment="CENTER" maxWidth="260.0" prefHeight="40.0" prefWidth="260.0" promptText="Email you registered with" style="-fx-background-color: transparent; -fx-text-fill: #3b2314; -fx-prompt-text-fill: #7a5c43; -fx-alignment: center; -fx-font-weight: bold;"><font><Font name="JetBrainsMono NF Light Italic" size="15.0" /></font></TextField>
               </children>
            </StackPane>

            <HBox alignment="CENTER" maxWidth="320.0" spacing="4.0">
               <children>
                  <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" prefHeight="36.0" prefWidth="36.0">
                     <children>
                        <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="rc1" alignment="CENTER" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 15px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" prefHeight="36.0" prefWidth="36.0">
                     <children>
                        <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="rc2" alignment="CENTER" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 15px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" prefHeight="36.0" prefWidth="36.0">
                     <children>
                        <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="rc3" alignment="CENTER" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 15px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" prefHeight="36.0" prefWidth="36.0">
                     <children>
                        <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="rc4" alignment="CENTER" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 15px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" prefHeight="36.0" prefWidth="36.0">
                     <children>
                        <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="rc5" alignment="CENTER" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 15px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" prefHeight="36.0" prefWidth="36.0">
                     <children>
                        <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/otp_square.png" /></image>
                        </ImageView>
                        <TextField fx:id="rc6" alignment="CENTER" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-text-fill: #f5e6c8; -fx-font-size: 15px; -fx-font-weight: bold; -fx-alignment: center;" />
                     </children>
                  </StackPane>
                  <StackPane maxHeight="36.0" maxWidth="76.0" minHeight="36.0" minWidth="76.0" prefHeight="36.0" prefWidth="76.0">
                     <HBox.margin><Insets left="6.0" /></HBox.margin>
                     <children>
                        <ImageView fitHeight="36.0" fitWidth="76.0" pickOnBounds="true" preserveRatio="false">
                           <image><Image url="@images/forSignUp/btn_send_code.png" /></image>
                        </ImageView>
                        <Button fx:id="resetSendButton" mnemonicParsing="false" onAction="#handleResetSend" prefHeight="36.0" prefWidth="76.0" style="-fx-background-color: transparent; -fx-cursor: hand;" />
                     </children>
                  </StackPane>
                  <TextField fx:id="resetCodeField" managed="false" visible="false" />
               </children>
            </HBox>
            <StackPane maxWidth="320.0" minWidth="320.0" prefWidth="320.0">
               <children>
                  <ImageView fitHeight="40.0" fitWidth="320.0" pickOnBounds="true">
                     <image><Image url="@images/input_box.png" /></image>
                  </ImageView>
                  <PasswordField fx:id="resetPasswordField" alignment="CENTER" maxWidth="260.0" prefHeight="40.0" prefWidth="260.0" promptText="New password" style="-fx-background-color: transparent; -fx-text-fill: #3b2314; -fx-prompt-text-fill: #7a5c43; -fx-alignment: center; -fx-font-weight: bold;"><font><Font name="JetBrainsMono NF Light Italic" size="15.0" /></font></PasswordField>
               </children>
            </StackPane>

            <Button fx:id="resetButton" mnemonicParsing="false" onAction="#handleResetPassword" prefWidth="200.0" styleClass="wood-button" text="Change password" />
            <Label fx:id="resetStatusLabel" maxWidth="340.0" styleClass="status-label" textAlignment="CENTER" wrapText="true" />
         </children>
      </VBox>

      <!-- ==================== SETTINGS PANE ==================== -->
      <VBox fx:id="settingsPane" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="250.0" prefWidth="422.0" spacing="8.0" translateX="-20.0" translateY="60.0" visible="false" StackPane.alignment="CENTER_RIGHT">
         <children>
            <Label styleClass="pane-title" text="Game Settings"><font><Font name="JetBrainsMono NF Light Italic" size="15.0" /></font></Label>
            <CheckBox fx:id="fullscreenCheck" mnemonicParsing="false" styleClass="remember-check" text="Start the game in fullscreen"><font><Font name="JetBrainsMono NF Light Italic" size="13.0" /></font></CheckBox>
            <HBox alignment="CENTER" maxWidth="320.0" spacing="10.0">
               <children>
                  <Label styleClass="pane-label" text="Resolution"><font><Font name="JetBrainsMono NF Light Italic" size="13.0" /></font></Label>
                  <StackPane maxWidth="190.0" minWidth="190.0" prefWidth="190.0">
                     <children>
                        <ImageView fitHeight="34.0" fitWidth="190.0" pickOnBounds="true">
                           <image><Image url="@images/input_box.png" /></image>
                        </ImageView>
                        <ComboBox fx:id="resolutionCombo" maxWidth="170.0" prefWidth="170.0" styleClass="plank-combo" />
                     </children>
                  </StackPane>
               </children>
            </HBox>
            <CheckBox fx:id="closeOnLaunchCheck" mnemonicParsing="false" styleClass="remember-check" text="Close the launcher when the game starts"><font><Font name="JetBrainsMono NF Light Italic" size="13.0" /></font></CheckBox>
            <Button fx:id="saveSettingsButton" mnemonicParsing="false" onAction="#handleSaveSettings" prefWidth="140.0" styleClass="wood-button" text="Save" />
            <Label fx:id="settingsStatusLabel" maxWidth="340.0" styleClass="status-label" textAlignment="CENTER" wrapText="true" />
         </children>
      </VBox>

      <!-- Shared Back button (top-left) for both the login and sign-up views.
           Kept outside the panes so it always sits in the same corner; the controller shows/hides it. -->
      <Button fx:id="backButton" mnemonicParsing="false" onAction="#showMainMenuView" styleClass="back-button" text="← Back" visible="false" StackPane.alignment="TOP_LEFT">
         <StackPane.margin><Insets left="14.0" top="14.0" /></StackPane.margin>
      </Button>

   </children>
</StackPane>
